# Mayura Jewellers Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas in prod, local/Atlas in dev)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ld0nlgc.mongodb.net/mayura_jewellers

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Admin Seed Setup
ADMIN_NAME="Mayura Admin"
ADMIN_EMAIL="admin@mayurajewellers.com"
ADMIN_PASSWORD="AdminSecurePassword123!"

# Cloudinary Media Upload Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Email & Notification Service Configuration
# Provider choices: console | resend | smtp (default: console)
EMAIL_PROVIDER=console
EMAIL_FROM=info@mayurajewellers.com
EMAIL_FROM_NAME="Mayura Jewellers"
EMAIL_REPLY_TO=info@mayurajewellers.com

# Production Provider Configurations (Optional based on chosen EMAIL_PROVIDER)
# Resend Provider
RESEND_API_KEY=re_your_resend_api_key_here

# SMTP Provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user_here
SMTP_PASSWORD=smtp_password_here
